<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medcare_doctor_tree" model="ir.ui.view">
        <field name="name">medcare.doctor.tree</field>
        <field name="model">medcare.doctor</field>
        <field name="arch" type="xml">
            <tree string="Doctors">
                <field name="doctor_ref"/>
                <field name="name"/>
                <field name="specialty"/>
                <field name="department_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="experience_years"/>
                <field name="status" widget="badge"
                       decoration-success="status=='active'"
                       decoration-warning="status=='on_leave'"
                       decoration-danger="status=='inactive'"/>
            </tree>
        </field>
    </record>

    <record id="view_medcare_doctor_form" model="ir.ui.view">
        <field name="name">medcare.doctor.form</field>
        <field name="model">medcare.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="active,on_leave,inactive"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Doctor Full Name"/></h1>
                        <field name="doctor_ref" readonly="1"/>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="experience_years"/>
                            <field name="specialty"/>
                            <field name="qualification"/>
                        </group>
                        <group string="Professional Details">
                            <field name="department_id"/>
                            <field name="consultation_fee"/>
                            <field name="license_number"/>
                            <field name="user_id" groups="medcare.group_medcare_admin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address">
                            <group>
                                <field name="street"/>
                                <field name="city"/>
                                <field name="country_id"/>
                            </group>
                        </page>
                        <page string="Brief About">
                            <field name="brief_about"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_medcare_doctor_search" model="ir.ui.view">
        <field name="name">medcare.doctor.search</field>
        <field name="model">medcare.doctor</field>
        <field name="arch" type="xml">
            <search string="Search Doctors">
                <field name="name"/>
                <field name="specialty"/>
                <field name="department_id"/>
                <field name="phone"/>
                <field name="email"/>
                <filter string="Active" name="active" domain="[('status','=','active')]"/>
                <filter string="On Leave" name="on_leave" domain="[('status','=','on_leave')]"/>
                <group expand="0" string="Group By">
                    <filter string="Specialty" name="group_specialty" context="{'group_by':'specialty'}"/>
                    <filter string="Department" name="group_department" context="{'group_by':'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_medcare_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">medcare.doctor</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_medcare_doctor_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first doctor</p>
        </field>
    </record>

</odoo>
