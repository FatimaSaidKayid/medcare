<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medcare_department_tree" model="ir.ui.view">
        <field name="name">medcare.department.tree</field>
        <field name="model">medcare.department</field>
        <field name="arch" type="xml">
            <tree string="Departments">
                <field name="name"/>
                <field name="doctor_count"/>
            </tree>
        </field>
    </record>

    <record id="view_medcare_department_form" model="ir.ui.view">
        <field name="name">medcare.department.form</field>
        <field name="model">medcare.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_doctors" type="object" class="oe_stat_button" icon="fa-user-md">
                            <field name="doctor_count" widget="statinfo" string="Doctors"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Cardiology"/></h1>
                    </div>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <!-- Only the doctors that belong to THIS department -->
                        <page string="Doctors" name="doctors">
                            <field name="doctor_ids" readonly="1">
                                <tree>
                                    <field name="doctor_ref"/>
                                    <field name="name"/>
                                    <field name="specialty"/>
                                    <field name="phone"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status=='active'"
                                           decoration-warning="status=='on_leave'"
                                           decoration-danger="status=='inactive'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medcare_department_search" model="ir.ui.view">
        <field name="name">medcare.department.search</field>
        <field name="model">medcare.department</field>
        <field name="arch" type="xml">
            <search string="Search Departments">
                <field name="name"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_medcare_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">medcare.department</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_medcare_department_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first department</p>
        </field>
    </record>

</odoo>
